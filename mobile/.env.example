# Required for account registration and login; sample preview works without an API.
# For physical iPhones use your Mac's LAN address, never phone localhost.
# EXPO_PUBLIC_API_URL=http://192.168.1.100:8000
# Production must use HTTPS. EXPO_PUBLIC values are public, never put secrets here.
EXPO_PUBLIC_API_URL=http://192.168.1.100:8000
